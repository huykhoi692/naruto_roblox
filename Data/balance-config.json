  "chakraSystem": {
    "regenPerSecond": 3,
    "regenInCombatMultiplier": 0.4,
    "regenOutOfCombatMultiplier": 1.0,
    "combatCooldownSeconds": 5,
    "combatCooldownNote": "Không bị/gây damage trong 5 giây = out of combat",
    "affinityDamageBonus": 0.15,
    "nonAffinityPenalty": 0,
    "nonAffinityNote": "Không phạt khi dùng jutsu sai hệ — chỉ không nhận bonus"
  },
  "damageFormula": {
    "formula": "finalDamage = (jutsuBaseDamage + attackStat) * affinityMult * levelScaling * defenseMitigation * randomVariance",
    "components": {
      "affinityMult": {
        "matching": 1.15,
        "nonMatching": 1.0
      },
      "levelScaling": {
        "formula": "1 + (attackerLevel - defenderLevel) * 0.02",
        "cap": 1.3,
        "floor": 0.7,
        "note": "Chênh lệch level tạo ra tối đa 30% damage bonus/penalty — không quá mất cân bằng"
      },
      "defenseMitigation": {
        "formula": "1 - (defenderDefense / (defenderDefense + 100))",
        "note": "Công thức diminishing returns — defense 100 giảm 50% damage, 200 giảm 67%, không bao giờ đạt 100%"
      },
      "randomVariance": {
        "min": 0.95,
        "max": 1.05,
        "note": "±5% random mỗi đòn để tránh damage quá đều"
      }
    }
  },
